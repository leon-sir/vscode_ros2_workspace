<!-- <? xml version = "1.0"?> -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
        
        <!-- Macro Definition -->
        <xacro:macro name = "g1_joint_controllers" params="joint_name:='right_hip_pitch_joint' 
                                command_interface_name:='effort' 
                                state_interface_position_name:='position' 
                                state_interface_velocity_name:='velocity' 
                                state_interface_effort_name:='effort' 
                                min_effort:='-1000' 
                                max_effort:='1000' 
                                initial_position:='0.0'">
                <joint name="${joint_name}">
                <command_interface name="${command_interface_name}">
                        <param name="min">${min_effort}</param>
                        <param name="max">${max_effort}</param>
                </command_interface>
                <state_interface name="${state_interface_position_name}">
                        <param name="initial_value">${initial_position}</param>
                </state_interface>
                <state_interface name="${state_interface_velocity_name}"/>
                <state_interface name="${state_interface_effort_name}"/>
                </joint>
        </xacro:macro>

        

        
        

</robot>






